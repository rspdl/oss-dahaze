            "examples": [
              "inventory.rspdl"
            ],
            "title": "Path",
            "type": "string"
          },
          "text": {
            "description": "RSPDL 소스 전문",
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "path",
          "text"
        ],
        "title": "SourceIn",
        "type": "object"
      },
      "UpdateDocumentRequest": {
