{
  "components": {
    "schemas": {
      "AddMemberRequest": {
        "properties": {
          "role": {
            "default": "editor",
            "description": "owner | editor | viewer",
            "title": "Role",
            "type": "string"
          },
          "user_id": {
            "format": "uuid",
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "user_id"
        ],
        "title": "AddMemberRequest",
        "type": "object"
      },
      "AnalysisResponse": {
        "description": "컴파일러 응답 하나.\n\n`result` 는 RSPDL SDK 가 준 그대로다. 모양은 컴파일러가 소유하고\n`wire_schema_version` 으로 버전이 매겨진다 — dahaze 가 재작성하지 않는다 (ADR-0003).\n진단은 예외가 아니라 이 안에 담겨 온다.",
        "properties": {
          "kind": {
            "description": "compile | check | find_model",
            "title": "Kind",
            "type": "string"
          },
          "locale": {
            "title": "Locale",
            "type": "string"
          },
          "result": {
            "additionalProperties": true,
            "description": "RSPDL SDK 결과 원본",
            "title": "Result",
            "type": "object"
          },
          "rspdl_version": {
            "description": "결과를 만든 컴파일러 버전",
            "title": "Rspdl Version",
            "type": "string"
          },
          "wire_schema_version": {
            "title": "Wire Schema Version",
            "type": "integer"
          }
        },
        "required": [
          "kind",
          "rspdl_version",
          "wire_schema_version",
          "locale",
          "result"
        ],
        "title": "AnalysisResponse",
        "type": "object"
      },
      "AuthProvidersResponse": {
        "description": "설정된 로그인 제공자. 프론트가 버튼을 하드코딩하지 않게 한다.",
        "properties": {
          "providers": {
            "items": {
              "type": "string"
            },
            "title": "Providers",
            "type": "array"
          }
        },
        "required": [
          "providers"
        ],
        "title": "AuthProvidersResponse",
        "type": "object"
      },
      "CheckRequest": {
        "properties": {
