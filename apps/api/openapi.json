              },
              {
                "type": "null"
              }
            ],
            "description": "모델별 가상 개체 수 상한. 작은 scope 의 UNSAT 은 전역 모순을 뜻하지 않는다.",
            "title": "Scope Per Model"
          },
          "source": {
            "$ref": "#/components/schemas/SourceIn"
          },
          "timeout_ms": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Timeout Ms"
          }
        },
        "required": [
          "source"
        ],
        "title": "FindModelRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
