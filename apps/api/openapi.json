      "CreateProjectRequest": {
        "properties": {
          "default_rspdl_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "새 문서가 기본으로 삼을 RSPDL 버전. 생략하면 서버의 컴파일러 버전",
