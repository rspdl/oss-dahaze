            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "display_name",
          "email",
          "avatar_url"
        ],
        "title": "CurrentUserResponse",
        "type": "object"
      },
      "DocumentResponse": {
        "description": "RSPDL 문서.\n\n컴파일 결과는 여기 없다. 필요하면 `/api/analysis/compile` 로 따로 묻는다 —\n텍스트가 진실이고 컴파일 결과는 파생물이다 (ADR-0003).",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "path": {
            "title": "Path",
            "type": "string"
          },
          "project_id": {
