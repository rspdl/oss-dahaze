  "info": {
    "description": "RSPDL 저작·검증 워크스페이스",
    "title": "dahaze API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/analysis/check": {
      "post": {
        "description": "runtime record 에 대해 제약과 정책을 검사한다.",
        "operationId": "check_workspace",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Check Workspace",
        "tags": [
          "analysis"
        ]
      }
    },
    "/api/analysis/compile": {
      "post": {
        "description": "소스를 Canonical IR 과 진단으로 컴파일한다.\n\n문법·의미 오류는 HTTP 오류가 아니라 200 응답의 `result` 안 진단으로 돌아온다.\n에디터가 오류 위치를 표시할 수 있어야 하기 때문이다.",
        "operationId": "compile_workspace",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompileRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Compile Workspace",
        "tags": [
          "analysis"
        ]
      }
    },
    "/api/analysis/model": {
      "post": {
        "description": "선언을 만족하는 가상 모델을 유한 scope 안에서 찾는다.\n\n실제 데이터를 받지 않는다. scope 안에 witness 가 없으면 `unsat_within_bound` 이며,\n이는 전역 모순이 아니라 \"이 범위에서는 못 찾았다\"는 뜻이다.",
        "operationId": "find_model",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FindModelRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Find Model",
        "tags": [
          "analysis"
        ]
      }
    },
    "/api/analysis/runtime": {
      "get": {
        "description": "이 서버가 사용하는 RSPDL 컴파일러의 정체.\n\n프론트가 문서의 target 버전과 비교해 불일치를 사용자에게 알리는 데 쓴다.",
        "operationId": "get_rspdl_runtime",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RspdlRuntimeResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Rspdl Runtime",
        "tags": [
          "analysis"
        ]
      }
    },
    "/api/auth/logout": {
      "post": {
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "Logout",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/me": {
      "get": {
        "operationId": "get_current_user",
        "parameters": [
          {
            "in": "cookie",
            "name": "dahaze_session",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Dahaze Session"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUserResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Current User",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/providers": {
      "get": {
        "description": "설정된 로그인 제공자 목록.\n\n프론트가 로그인 버튼을 하드코딩하지 않도록 서버가 알려준다. 자격증명이 없는\n제공자는 애초에 등록되지 않는다.",
        "operationId": "list_auth_providers",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthProvidersResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Auth Providers",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/{provider}/callback": {
      "get": {
        "operationId": "complete_oauth_login",
        "parameters": [
          {
            "in": "path",
            "name": "provider",
            "required": true,
            "schema": {
              "title": "Provider",
              "type": "string"
