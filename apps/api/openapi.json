        },
        "required": [
          "id",
          "document_id",
          "revision_no",
          "target_rspdl_version",
          "author_id",
          "summary",
          "created_at"
        ],
        "title": "DocumentRevisionResponse",
        "type": "object"
      },
      "DocumentSummaryResponse": {
        "description": "목록용. 본문을 싣지 않는다.",
