            "type": "string"
          },
          "slug": {
            "description": "URL 에 쓰이는 식별자. 소문자·숫자·하이픈",
            "examples": [
              "order-service"
            ],
            "maxLength": 100,
            "minLength": 1,
            "title": "Slug",
            "type": "string"
          }
        },
        "required": [
          "slug",
          "name"
        ],
        "title": "CreateProjectRequest",
        "type": "object"
      },
      "CurrentUserResponse": {
