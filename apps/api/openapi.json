          },
          "path": {
            "title": "Path",
            "type": "string"
          },
          "project_id": {
            "format": "uuid",
            "title": "Project Id",
            "type": "string"
          },
          "target_rspdl_version": {
            "title": "Target Rspdl Version",
            "type": "string"
          },
          "title": {
