        "properties": {
          "locale": {
            "title": "Locale",
            "type": "string"
          },
          "rspdl_version": {
            "title": "Rspdl Version",
            "type": "string"
          },
          "wire_schema_version": {
            "title": "Wire Schema Version",
            "type": "integer"
          }
