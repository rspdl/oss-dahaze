# apps/api 로컬 설정. 이 파일을 .env 로 복사해 쓴다.
# 실제 값이 든 .env 는 커밋하지 않는다 (.gitignore 대상).

ENVIRONMENT=development
PORT=8400

# --- DB ---
# 로컬 Postgres: docker compose -f deploy/docker-compose.dev.yml up -d
# 호스트 포트가 5432 가 아닌 이유는 그 파일 주석 참고.
DATABASE_URL=postgresql://dahaze:dahaze@localhost:55432/dahaze

# --- 세션 ---
# 세션 쿠키와 MCP Bearer 토큰이 모두 이 비밀로 서명된다 (audience 만 다르다).
# ENVIRONMENT 가 development 가 아니면, 기본값이거나 32바이트 미만이면 앱이 뜨지 않는다.
#   openssl rand -hex 32
SESSION_SECRET=dev-only-change-me
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# 프로덕션에서만 상위 도메인을 넣는다 (예: .dahaze.xyz). 로컬은 비워 둔다.
# COOKIE_DOMAIN=

# --- CORS ---
CORS_ALLOW_ORIGINS=http://localhost:3400

# --- GitHub OAuth ---
# 로컬용 OAuth App 을 따로 만든다. 콜백은 아래 OAUTH_REDIRECT_URI 와 같아야 한다.
# 자격증명이 없으면 github 제공자가 아예 등록되지 않는다 (registry.py).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8400/api/auth/github/callback
WEB_POST_LOGIN_URL=http://localhost:3400

# --- LLM ---
# 비어 있으면 /api/authoring/* 만 503 이 되고 나머지 API 는 정상 동작한다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
