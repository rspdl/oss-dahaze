# Parameter Store 에 넣을 값. 이 파일을 `secrets.env` 로 복사해 값을 채운 뒤
# `./deploy/lightsail/put-secrets.sh` 를 실행한다.
#
#   cp deploy/lightsail/secrets.example.env deploy/lightsail/secrets.env
#   $EDITOR deploy/lightsail/secrets.env
#   ./deploy/lightsail/put-secrets.sh
#
# `secrets.env` 는 .gitignore 대상이다. 그래도 업로드가 끝나면 지우는 편이 낫다 —
# 스크립트가 마지막에 물어본다.
#
# 값에 따옴표를 두르지 않는다. `KEY=값` 그대로 쓴다. 줄바꿈이 든 값은 .env 형식이
# 담을 수 없으므로 스크립트가 거부한다.

# --- GitHub OAuth App -------------------------------------------------------
#
# https://github.com/settings/developers → New OAuth App
#   Application name:            dahaze (production)
#   Homepage URL:                https://app.dahaze.xyz
#   Authorization callback URL:  https://api.dahaze.xyz/api/auth/github/callback
#
# 콜백 URL 은 /dahaze/prod/OAUTH_REDIRECT_URI 와 **정확히** 같아야 한다. 다르면 GitHub 이
# redirect_uri_mismatch 로 거부한다.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- OpenAI -----------------------------------------------------------------
#
# https://platform.openai.com/api-keys
# 비워 두면 저작 엔드포인트(/api/authoring/*)만 503 이 되고 나머지 API 는 정상 동작한다.
OPENAI_API_KEY=
