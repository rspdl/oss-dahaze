{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "openapi": {
      "inputs": [
        "src/**/*.py",
        "pyproject.toml"
      ],
      "outputs": [
        "openapi.json"
      ],
      "cache": false
    },
    "codegen": {
      "inputs": [
        "orval.config.ts",
        "../../apps/api/openapi.json"
      ],
      "outputs": [
        "src/generated/**"
      ]
    },
    "build": {
      "dependsOn": [
        "^build",
        "codegen"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "typecheck": {
      "dependsOn": [
        "^build",
        "codegen"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
