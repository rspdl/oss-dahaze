#!/bin/sh
#
# ⚠ 바깥쪽은 **POSIX sh** 여야 하고, 전체가 **작아야** 한다.
#
# 두 가지 제약이 여기 겹쳐 있다.
#
# 1) Lightsail 은 자기 초기화 스크립트 뒤에 user_data 를 이어 붙여 하나로 실행한다.
#    그래서 여기 적는 shebang 은 파일 중간의 주석이 되고, 전체가 /bin/sh(dash)로 돈다.
#    `set -o pipefail` 하나에 통째로 죽는다:
#      part-001: 26: set: Illegal option -o pipefail
#    실제로 이걸로 첫 인스턴스가 아무것도 설치되지 않은 채 떴다.
#
# 2) 16KB 한도는 **Lightsail 자기 스크립트를 합친 크기**에 걸린다. 렌더 결과가 11KB 여도
#    거부당한다. 그래서 여기서는 SSM 등록까지만 하고, 나머지는 Run Command 로
#    `deploy/lightsail/bootstrap.sh` 를 실행한다. 재실행이 되고 고치기도 쉽다.

set -eu

cat >/usr/local/bin/dahaze-stage1 <<'STAGE1_EOF'
#!/bin/bash
#
# dahaze 백엔드 호스트의 최초 부팅 스크립트. cloud-init 이 root 로 한 번만 실행한다.
#
# 여기 들어가는 것의 기준: **재부팅해도 변하지 않는 호스트의 성질.**
# 애플리케이션 이미지·.env 값·마이그레이션은 배포(deploy/lightsail/rollout.sh)의 일이다.
# 그 둘을 섞으면 "인프라를 다시 만들어야 배포가 된다" 는 상태가 된다.
#
# set -x 를 켜지 않는다. 아래 등록 명령의 활성화 코드가 로그 파일에 그대로 남는다.

set -euo pipefail

LOG=/var/log/dahaze-bootstrap.log
exec >>"$LOG" 2>&1

log() { printf '\n=== %s :: %s\n' "$(date -Is)" "$1"; }

# ---------------------------------------------------------------------------
# 0. 아키텍처
# ---------------------------------------------------------------------------
# Terraform 변수 validation 이 ARM 번들을 이미 막지만, 그건 번들 ID 라는 이름을 믿는
# 검사다. 실제로 도는 커널에 물어보는 검사를 한 번 더 둔다 — 여기서 틀렸다면 뒤의
# 모든 설치가 무의미하다 (ADR-0002).
ARCH=$(uname -m)
if [ "$ARCH" != "x86_64" ]; then
  log "치명적: $ARCH 는 지원하지 않는다. RSPDL 은 linux aarch64 wheel 도 sdist 도 배포하지 않는다."
  exit 1
fi
log "아키텍처 $ARCH"

export DEBIAN_FRONTEND=noninteractive
# cloud-init 과 unattended-upgrades 가 같은 apt 락을 잡고 있을 수 있다. 기다린다.
APT="apt-get -o DPkg::Lock::Timeout=600 -y"

# ---------------------------------------------------------------------------
# 1. 기본 패키지
# ---------------------------------------------------------------------------
log "기본 패키지"
$APT update
# git 이 필요한 이유: 배포가 SSH 로 파일을 밀어 넣지 않는다. 인스턴스가 저장소에서
# compose 파일과 nginx 설정을 직접 가져온다 (DEPLOY.md 의 저장소 배치 단계).
$APT install ca-certificates curl gnupg unzip jq openssl git \
  nginx certbot python3-certbot-nginx

# ---------------------------------------------------------------------------
# 2. 스왑
# ---------------------------------------------------------------------------
# Lightsail 인스턴스에는 스왑이 없다. Z3 힙이 순간적으로 부푸는 컴파일 요청 하나가
# OOM killer 를 부르고, OOM killer 는 보통 가장 큰 상주 프로세스인 Postgres 를 고른다.
# 스왑은 그 순간을 느리게 만들 뿐이지만, "느려짐" 과 "DB 프로세스 사망" 은 다른 사건이다.
if [ ! -f /swapfile ]; then
  log "스왑 2G"
  fallocate -l 2G /swapfile
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile none swap sw 0 0' >>/etc/fstab
  # 스왑은 비상용이다. 평소에 여기로 밀려나면 응답 시간만 나빠진다.
  sysctl -w vm.swappiness=10
  echo 'vm.swappiness=10' >/etc/sysctl.d/60-dahaze-swappiness.conf
fi

# ---------------------------------------------------------------------------
# 3. AWS CLI
# ---------------------------------------------------------------------------
# 인스턴스가 자기 SSM 파라미터를 직접 읽는다(dahaze-env-sync). Ubuntu 저장소의 awscli 는
# v1 이고 오래됐으므로 공식 v2 를 쓴다.
log "AWS CLI v2"
curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip
unzip -q /tmp/awscliv2.zip -d /tmp
/tmp/aws/install
rm -rf /tmp/aws /tmp/awscliv2.zip

# ---------------------------------------------------------------------------
# 4. SSM 에이전트 등록
# ---------------------------------------------------------------------------
# 가장 먼저 해야 하는 기능적 단계다. 22번 포트가 닫혀 있으므로, 이 등록이 실패하면
# 이 박스로 들어갈 길이 없다. 뒤 단계가 깨지더라도 최소한 Session Manager 로 들어와
# 로그를 볼 수 있어야 한다.
#
# ssm-setup-cli 가 설치·등록·서비스 기동을 한 번에 처리한다. 등록이 끝나면 이 노드는
# mi-* ID 를 받고, 그때부터 Terraform 이 만든 인스턴스 역할의 자격증명을 받아 온다.
log "SSM 에이전트 등록"
mkdir -p /tmp/ssm
curl -fsSL "https://amazon-ssm-${region}.s3.${region}.amazonaws.com/latest/debian_amd64/ssm-setup-cli" \
  -o /tmp/ssm/ssm-setup-cli
chmod +x /tmp/ssm/ssm-setup-cli
/tmp/ssm/ssm-setup-cli \
  -register \
  -activation-code "${activation_code}" \
  -activation-id "${activation_id}" \
  -region "${region}"
rm -f /tmp/ssm/ssm-setup-cli

# ---------------------------------------------------------------------------

log "1단계 완료 — SSM 등록됨. 나머지는 Run Command 로 bootstrap.sh 를 실행한다."
STAGE1_EOF

chmod 0755 /usr/local/bin/dahaze-stage1
/usr/local/bin/dahaze-stage1 2>&1 | tee -a /var/log/dahaze-bootstrap.log
